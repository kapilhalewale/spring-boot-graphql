schema {
 query: ProductQuery
 mutation: ProductMutation
}

type Product {
  id: Long,
  name: String,
  category: String,
  discounts : [Discount]
}

type Discount {
  productId: Long,
  offerName: String
}


type ProductQuery {
 getProducts: [Product]
 getProduct(id: Long): Product
 getProductByCategory(category: String): [Product]
}

type ProductMutation {
    createProduct(name: String, category: String): Product!
    deleteProduct(id: Long): Long
}
